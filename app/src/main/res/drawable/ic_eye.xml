<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Icon displayed when password text is visible (Eye open) -->
    <item android:state_checked="true" android:drawable="@drawable/ic_eye_open" />
    <!-- Icon displayed when password text is hidden (Eye slashed) -->
    <item android:drawable="@drawable/ic_eye_off" />
</selector>